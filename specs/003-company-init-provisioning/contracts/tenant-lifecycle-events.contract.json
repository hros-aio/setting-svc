{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenantCreatedEventEnvelope",
  "type": "object",
  "required": ["id", "topic", "eventType", "timestamp", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique event identifier UUID"
    },
    "correlationId": {
      "type": "string",
      "description": "Distributed correlation ID for tracing"
    },
    "topic": {
      "type": "string",
      "enum": ["tenant.lifecycle-events"]
    },
    "eventType": {
      "type": "string",
      "enum": ["tenant.created", "tenant.provisioned"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["tenantId", "tenantCode", "name"],
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "legalName": {
          "type": "string",
          "maxLength": 255
        },
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "currencyCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        },
        "sourceVersion": {
          "type": "integer",
          "default": 1
        }
      }
    }
  }
}
